# ==========================================================
# PayPulse AI — Environment Configuration (.env.example)
# Copy this file to .env.local and fill in your credentials
# ==========================================================

# 1. PayPal Developer Sandbox Credentials
# Get yours at: https://developer.paypal.com/dashboard/applications/sandbox
# Note: Only PAYPAL_ENVIRONMENT=sandbox is permitted in this build (enforced server-side).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Optional: Public URL used for PayPal redirect return/cancel URLs (defaults to request origin)
# APP_BASE_URL=https://your-deployment.onrender.com

# Optional: Allow browser-entered API keys in production (defaults to false in NODE_ENV=production)
# ALLOW_RUNTIME_CREDENTIALS=false

# 2. Google Gemini API Key (Powers Two-Agent Negotiation & Deliverable Review via gemini-3.8-flash)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
